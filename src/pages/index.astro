---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const title = 'SMS360X — Safety intelligence for modern aviation';
const description =
  'SMS360X turns safety data into safety information, and safety information into safety intelligence — so operators, regulators, and states can make defensible decisions.';
---

<Base title={title} description={description}>
  <header class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="radar-container">
          <div class="radar-sweep"></div>
          <div class="radar-circle circle-1"></div>
          <div class="radar-circle circle-2"></div>
        </div>
        <div class="hero-text">
          <h1>Safety intelligence for modern aviation.</h1>
          <p class="lead">
            SMS360X turns safety data into safety information, and safety
            information into safety intelligence — so operators, regulators, and
            states can make defensible decisions.
          </p>
          <button class="button" onclick="document.getElementById('demo-modal')?.showModal()">Request an early demo</button>
        </div>
        <div class="hero-image">
          <img src="/Hero Image.png" alt="SMS360X safety intelligence card" />
        </div>
      </div>
    </div>
  </header>

  <main>
    <Section id="what-sms360x-does">
      <h2>What SMS360X does</h2>
      <div class="section-2-wrapper">
        <div class="columns">
          <div class="column">
            <h3>Capture</h3>
            <p>
              Occurrences, hazards, risks, and barriers in a single coherent
              model, aligned with ICAO Annex 19 and Doc 9859.
            </p>
          </div>
          <div class="column">
            <h3>Connect</h3>
            <p>
              Safety data linked across State, Regulator, Operator, and User,
              with tenant isolation by design.
            </p>
          </div>
          <div class="column">
            <h3>Decide</h3>
            <p>
              Dashboards and intelligence for safety managers, accountable
              executives, regulators, and state safety programmes.
            </p>
          </div>
        </div>
        <p class="section-note">
          From frontline reporting to boardroom decisions, SMS360X provides a
          single source of truth.
        </p>
      </div>
    </Section>

    <Section id="platform-flow" class="surface" style="padding: 6rem 0;">
      <h2 style="text-align: center; margin-bottom: 3rem;">Platform flow</h2>
      <ol class="flow" style="display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; padding: 0;">
        <li>Safety Data</li>
        <li>Safety Information</li>
        <li>Safety Intelligence</li>
        <li>Decision Support</li>
      </ol>
    </Section>

    <Section id="frameworks" style="max-width: 800px; margin-left: 0;">
      <h2>Built on international frameworks</h2>
      <p>
        SMS360X is grounded in the standards and guidance that already govern
        aviation safety management.
      </p>
      <ul class="frameworks" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem;">
        <li>ICAO Annex 19</li>
        <li>ICAO Doc 9859</li>
        <li>ICAO Doc 10159</li>
        <li>ADREP</li>
        <li>HFACS</li>
      </ul>
      <p class="section-note">
        Compliance isn't an afterthought — it's the foundation. Your data is
        structured to meet ICAO and state requirements out of the box.
      </p>
    </Section>

    <Section id="who-it-is-for" class="surface">
      <h2>Who it is for</h2>
      <ul class="audience">
        <li>Safety Managers</li>
        <li>Accountable Executives</li>
        <li>Regulators</li>
        <li>State Safety Programmes</li>
      </ul>
    </Section>

    <Section id="early-access">
      <h2>Early access</h2>
      <p>
        SMS360X is in active development. We are inviting a small number of
        operators and regulators to participate in an early demo.
      </p>
      <div class="early-access-button" style="display: flex; justify-content: flex-end; margin-top: 2rem;">
        <button class="button" onclick="document.getElementById('demo-modal')?.showModal()">Request an early demo</button>
      </div>
    </Section>

    <dialog id="demo-modal" class="modal">
      <div class="modal-content">
        <button class="modal-close" onclick="document.getElementById('demo-modal')?.close()">×</button>
        <h2>Request an Early Demo</h2>
        <form action="https://api.web3forms.com/submit" method="POST" class="demo-form" novalidate>
          <input type="hidden" name="access_key" value="5d866176-c3b5-4cae-bd56-31a3f7d4f331" />
          <input type="hidden" name="subject" value="New Early Demo Request - SMS360X" />
          <input type="hidden" name="to" value="sms360x@gmail.com" />
          <div class="form-group">
            <label for="modal-demo-name">Name</label>
            <input
              type="text"
              id="modal-demo-name"
              name="name"
              placeholder="Your name"
              required
            />
          </div>
          <div class="form-group">
            <label for="modal-demo-email">Email</label>
            <input
              type="email"
              id="modal-demo-email"
              name="email"
              placeholder="you@company.com"
              required
            />
          </div>
          <div class="form-group">
            <label for="modal-demo-company">Company</label>
            <input
              type="text"
              id="modal-demo-company"
              name="company"
              placeholder="Company / organisation"
            />
          </div>
          <div class="form-group">
            <label for="modal-demo-message">Message</label>
            <textarea
              id="modal-demo-message"
              name="message"
              rows="4"
              placeholder="Anything you'd like us to know?"
            ></textarea>
          </div>
          <button type="submit" class="button">Send Request</button>
        </form>
      </div>
    </dialog>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span class="brand">SMS360X</span>
      <p class="footer-attribution">
        A <a href="https://gsacharya.com" target="_blank" rel="noopener noreferrer">gsacharya.com</a> project
      </p>
    </div>
  </footer>
</Base>

<style is:global>
  .hero {
    padding-block: clamp(4rem, 10vw, 8rem);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .hero h1 {
    max-width: 20ch;
  }

  .hero .lead {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    max-width: 55ch;
  }

  .hero .button {
    margin-top: var(--space-6);
  }

  .hero-content {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-text {
    flex: 1 1 300px;
    position: relative;
    z-index: 10;
  }

  .hero-image {
    flex: 1 1 300px;
    position: relative;
    z-index: 10;
  }

  .hero-image img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
  }

  @media (max-width: 640px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
    }
    .hero-text {
      order: 1;
    }
    .hero-image {
      order: 2;
    }
  }

  .surface {
    background-color: var(--color-surface);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
  }

  .column h3 {
    margin-bottom: var(--space-3);
  }

  .column p {
    color: var(--color-text-muted);
  }

  .section-note {
    text-align: center;
    color: var(--color-text-muted);
    margin-top: 3rem;
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
  }

  .section-2-wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  .radar-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    z-index: 1;
    pointer-events: none;
    opacity: 0.15;
  }

  .radar-sweep {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(13, 148, 136, 0.8) 90deg,
      transparent 90deg
    );
    animation: radar-spin 6s linear infinite;
  }

  .radar-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(13, 148, 136, 0.4);
  }

  .circle-1 {
    width: 66%;
    height: 66%;
  }

  .circle-2 {
    width: 33%;
    height: 33%;
  }

  @keyframes radar-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 768px) {
    .radar-container {
      width: 400px;
      height: 400px;
      top: 30%;
    }
  }

  .frameworks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .frameworks li {
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .audience {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .audience li {
    padding: var(--space-5);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-weight: 600;
  }

  .site-footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .footer-attribution {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .footer-attribution a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer-attribution a:hover {
    color: var(--color-accent);
  }

  .demo-form {
    display: grid;
    gap: var(--space-4);
    max-width: 42rem;
    margin: 0 auto;
  }

  .demo-form .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .demo-form label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .demo-form input,
  .demo-form textarea {
    width: 100%;
    padding: var(--space-3);
    font-size: 1rem;
    font-family: inherit;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-sizing: border-box;
  }

  .demo-form input:focus,
  .demo-form textarea:focus {
    outline: none;
    border-color: var(--color-primary, var(--color-border));
  }

  .demo-form button.button {
    width: 100%;
    margin-top: var(--space-2);
  }

  .modal {
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .modal::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
  }

  .modal-content {
    position: relative;
    max-width: 42rem;
    width: 92vw;
    max-height: 90vh;
    overflow-y: auto;
    padding: var(--space-8);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-sizing: border-box;
    margin: auto;
  }

  .modal-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: var(--space-1);
    color: var(--color-text-muted);
  }

  .modal-close:hover {
    color: var(--color-text);
  }

  .modal h2 {
    margin-top: 0;
    margin-bottom: var(--space-4);
  }

  .demo-form {
    display: grid;
    gap: var(--space-4);
  }
</style>
